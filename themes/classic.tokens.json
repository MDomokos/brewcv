{
  "$description": "B2 Marker, Classic",
  "$extensions": {
    "resume-builder": {
      "name": "B2 Marker, Classic",
      "version": 1
    }
  },
  "color": {
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.851,
          0
        ],
        "hex": "#ffd900"
      }
    },
    "tab": {
      "$type": "color",
      "$value": "{color.accent}"
    },
    "highlight": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.851,
          0
        ],
        "hex": "#ffd900"
      }
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "hex": "#1a1a1a"
      }
    },
    "ink-body": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1725,
          0.1725,
          0.1725
        ],
        "hex": "#2c2c2c"
      }
    },
    "muted": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3333,
          0.3333,
          0.3529
        ],
        "hex": "#55555a"
      }
    },
    "meta": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5412,
          0.5412,
          0.5412
        ],
        "hex": "#8a8a8a"
      }
    },
    "page": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    }
  },
  "font": {
    "body": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Source Serif 4",
          "Georgia",
          "serif"
        ]
      }
    },
    "mono": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Source Sans 3",
          "Hanken Grotesk",
          "sans-serif"
        ]
      }
    },
    "name": {
      "weight": {
        "$type": "fontWeight",
        "$value": 400
      }
    }
  },
  "size": {
    "name": {
      "$type": "dimension",
      "$value": {
        "value": 33,
        "unit": "px"
      }
    },
    "heading": {
      "$type": "dimension",
      "$value": {
        "value": 14.4,
        "unit": "px"
      }
    },
    "body": {
      "$type": "dimension",
      "$value": {
        "value": 12.7,
        "unit": "px"
      }
    },
    "meta": {
      "$type": "dimension",
      "$value": {
        "value": 11,
        "unit": "px"
      }
    }
  },
  "line-height": {
    "body": {
      "$type": "number",
      "$value": 1.42
    }
  },
  "tracking": {
    "label": {
      "$type": "dimension",
      "$value": {
        "value": 0.14,
        "unit": "em"
      }
    }
  },
  "space": {
    "section": {
      "$type": "dimension",
      "$value": {
        "value": 22,
        "unit": "px"
      }
    },
    "bullet": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  }
}
